      "$other": {
        ".write": "(auth != null && root.child('roles').child(auth.uid).val() === 'gm') && root.child('sessionControl').child('phase').val() !== 'loading' && root.child('sessionControl').child('phase').val() !== 'resetting'"
      }
    },
    "saves": {
      ".read": "auth != null && root.child('roles').child(auth.uid).val() === 'gm'",
      ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'gm'",
      ".indexOn": [
        "_savedAt"
      ]
    },
    "sessionControl": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'gm'"
    },
    "sessionClients": {
      ".read": "auth != null && root.child('roles').child(auth.uid).val() === 'gm'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$client": {
          ".validate": "newData.val() === true"
        }
      }
    },
    "sessionAcks": {
      ".read": "auth != null && root.child('roles').child(auth.uid).val() === 'gm'",
      "$operation": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('sessionControl').child('id').val() === $operation",
          "$client": {
            ".validate": "newData.hasChildren(['ok']) && newData.child('ok').isBoolean()"
          }
        }
      }
    }
  }
}
